# Copiar a secrets.toml (NUNCA commitear ese archivo) para desarrollo local.
# En Streamlit Community Cloud, estos mismos valores van en el panel de Secrets
# de la app, no en un archivo del repo.

TURSO_DATABASE_URL = "libsql://<tu-base>-<tu-org>.turso.io"
TURSO_AUTH_TOKEN = "<token generado con: turso db tokens create <tu-base>>"
